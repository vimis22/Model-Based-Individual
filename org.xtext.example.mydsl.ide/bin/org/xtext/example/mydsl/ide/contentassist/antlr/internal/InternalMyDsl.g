RULE_LINE : ('rightVerticalLine'|'leftVertical' RULE_BOOLEAN);

RULE_POSITION : ('left'|'center'|'right');

RULE_LETTER : ('a'..'z'|'A'..'Z');

fragment RULE_ALPHANUMERIC : (RULE_INT|RULE_LETTER);

RULE_COLORSTRING : (RULE_LETTER+|'#' RULE_ALPHANUMERIC+|'RGB(' RULE_INT+ ',' RULE_INT+ ',' RULE_INT+ ')');

fragment RULE_BOOLEAN : ('true'|'false');

RULE_CELLREF : 'A'..'Z' '0'..'9';

RULE_ID : '^'? ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;

RULE_INT : ('0'..'9')+;

RULE_STRING : ('"' ('\\' .|~(('\\'|'"')))* '"'|'\'' ('\\' .|~(('\\'|'\'')))* '\'');

RULE_ML_COMMENT : '/*' ( options {greedy=false;} : . )*'*/';

RULE_SL_COMMENT : '//' ~(('\n'|'\r'))* ('\r'? '\n')?;

RULE_WS : (' '|'\t'|'\r'|'\n')+;

RULE_ANY_OTHER : .;
