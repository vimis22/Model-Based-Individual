grammar org.xtext.example.mydsl.MyDsl with org.eclipse.xtext.common.Terminals

generate myDsl "http://www.xtext.org/example/mydsl/MyDsl"

Table: 'Table' name=ID nrColumns=NrColumns (columns+=Column)+;

//terminal NUMBER: ('0'..'9');
terminal LINE: 'rightVerticalLine'|'leftVertical' BOOLEAN;
terminal POSITION: 'left' | 'center' | 'right';
terminal LETTER: ('a'..'z'|'A'..'Z');
terminal ALPHANUMERIC: INT | LETTER;
terminal COLORSTRING: LETTER+ | '#' ALPHANUMERIC+ | 'RGB('INT+','INT+','INT+')';
terminal BOOLEAN: 'true' | 'false';
terminal CELLREF: ('A'..'Z')('0'..'9');

Column: 'Column' letter=LETTER (width=WIDTH)? (alignment=ALIGNMENT)? (color=COLOR)? (line+=LINE)* (cell+=CELL)* ; 
NrColumns: 'Columns' Nr+=INT;
WIDTH: 'Width' number=INT 'cm';
ALIGNMENT: 'Alignment' position=POSITION;
COLOR: 'Color' colorstring=COLORSTRING;
CELL: 'Cell' number=INT color=COLOR? value=VALUE?;

MATH: 'sum' | 'mean' |'median';
VALUE: 'Value' (string=STRING | expr=ADD | math=MATH range=CELLRANGE);
ADD: sub1=SUB ('+' sub2+=SUB)*;
SUB: mult1=MULT ('-' mult2+=MULT)*;
MULT: divid1=DIVID ('*' divid2+=DIVID)*;
DIVID: prim1=PRIM ('/' prim2+=PRIM)*;
PRIM: mathunit=MATHUNIT | ('(' add=ADD ')');
//MATHOPS: '+' | '-' |'*' |'/';
//CELLREF: letter=LETTER number=INT;
CELLRANGE: rangestart=CELLREF ':' rangeend=CELLREF;
MATHUNIT: number=INT | cellref=CELLREF;
//EXPR: mathunit=MATHUNIT (mathops+=MATHOPS mathunit2+=MATHUNIT)*;
//VALUE: 'Value' (string=STRING | expr=EXPR | math=MATH mathexpr=EXPR);



